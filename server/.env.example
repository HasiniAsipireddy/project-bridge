NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Pooled endpoint (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_bridge?schema=public"
# Same credentials/database as DATABASE_URL but the direct endpoint (drop the
# "-pooler" from the host). Only prisma migrate uses it; the pooler breaks the
# advisory locks migrations need.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Signs the session JWT. Generate your own, never reuse this value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string"
# Any ms/vercel duration string, e.g. 15m, 12h, 7d.
JWT_EXPIRES_IN=7d

# --- AWS S3 (uploads) ---
# The bucket stays private: objects are read through short-lived presigned URLs.
AWS_REGION=eu-north-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
# Lifetime of presigned GET URLs, in seconds. Default 3600 (1 hour).
S3_URL_EXPIRES_IN=3600
