# --- AWS Secrets Manager (loaded first, at boot) ---
# On startup src/lib/loadSecrets.js fetches this secret and writes its JSON
# key-value pairs onto process.env, OVERRIDING the values below for those keys.
# The secret currently holds: DATABASE_URL, DIRECT_URL, JWT_SECRET,
# AWS_SECRET_ACCESS_KEY.
# If the call fails (no AWS access, offline, wrong region) the app logs a
# warning and keeps running on the .env values below, so local dev still works.
AWS_SECRETS_ID=project-bridge
# How long to wait for Secrets Manager before falling back, in ms. Default 5000.
AWS_SECRETS_TIMEOUT_MS=5000

# AWS_REGION and AWS_ACCESS_KEY_ID are NOT in the secret — they authenticate the
# call that fetches it. Same for AWS_SECRET_ACCESS_KEY: the secret carries a
# copy for runtime use, but a bootstrap value must exist here (or come from an
# instance role) or the fetch itself cannot be signed.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Database (in Secrets Manager; values here are the local-dev fallback) ---
# Pooled endpoint (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_bridge?schema=public"
# Same credentials/database as DATABASE_URL but the direct endpoint (drop the
# "-pooler" from the host). Only prisma migrate uses it; the pooler breaks the
# advisory locks migrations need. Note the Prisma CLI does NOT run loadSecrets,
# so migrations always read this value from .env.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Auth (JWT_SECRET is in Secrets Manager; this is the fallback) ---
# Signs the session JWT. Generate your own, never reuse this value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string"
# Any ms/vercel duration string, e.g. 15m, 12h, 7d.
JWT_EXPIRES_IN=7d

# --- AWS S3 (uploads) ---
# The bucket stays private: objects are read through short-lived presigned URLs.
AWS_S3_BUCKET=your-bucket-name
# Lifetime of presigned GET URLs, in seconds. Default 3600 (1 hour).
S3_URL_EXPIRES_IN=3600

# --- AWS SES (request notification emails) ---
# Must be verified in SES. While the account is in sandbox mode the recipient
# has to be verified too, so unverified addresses simply never receive mail.
AWS_SES_FROM_EMAIL=you@example.com
